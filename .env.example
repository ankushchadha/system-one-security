# Only the backends you run need keys.
TYPESAFE_API_KEY=
JEV_MODEL=jev-1.13.0
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_ACCOUNT_ID=
# Optional: path (absolute, or relative to the current directory) to a module exporting `createFetch(): Promise<typeof fetch>`,
# for routing requests through a credential proxy instead of env keys.
FETCH_MODULE=
